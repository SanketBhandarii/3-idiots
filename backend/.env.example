# Go backend — copy to backend/.env. Go is the ONLY service that talks to PostgreSQL. NEVER commit real values.
APP_ENV=development
# Listen address of the API
API_ADDR=:8080
# Neon: use the DIRECT host (without "-pooler"); must have pgvector + pg_trgm + pgcrypto available
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Browser origins allowed for cookies/WebSocket (comma separated)
WEB_ORIGINS=http://localhost:3000
# HMAC secret for the httpOnly JWT cookie (>= 32 random chars, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-64-random-hex-chars-at-least-32-characters
# Python AI service + shared internal key (same value in agent/.env)
AGENT_URL=http://127.0.0.1:8000
AGENT_INTERNAL_KEY=same-value-as-agent-env-min-16-chars
# Optional
DB_MAX_CONNS=10
MIGRATE_ON_START=true
LOG_LEVEL=info
