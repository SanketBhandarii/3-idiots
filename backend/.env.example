APP_ENV=development
API_ADDR=:8080
# Neon: use the DIRECT host (without "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
WEB_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-to-64-random-hex-chars-at-least-32-characters
AGENT_URL=http://127.0.0.1:8000
AGENT_INTERNAL_KEY=same-value-as-agent-env-min-16-chars
